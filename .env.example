# Engineering Drawing Analysis System - Environment Variables
# Copy this file to .env and fill in your own values.
#
# NEVER commit a real key. .env is gitignored; this file is not.

# --- Vision model (required for drawing analysis) --------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro-latest
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=8192

# --- OCR --------------------------------------------------------------------
OCR_USE_GPU=false
OCR_LANG=en
OCR_DET_DB_THRESH=0.3
OCR_DET_DB_BOX_THRESH=0.5

# --- Server -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# --- Rendering --------------------------------------------------------------
# Higher DPI reads small annotation text better but is slower per page.
PDF_RENDER_DPI=300
MAX_IMAGE_SIZE=4096

# --- Extraction thresholds --------------------------------------------------
# A drawing value below this confidence is reported as "Not Detected"
# rather than written into the report.
DIMENSION_CONFIDENCE_THRESHOLD=0.4

# --- Report -----------------------------------------------------------------
REPORT_COMPANY_NAME=Engineering Analysis System

# --- Custom YOLO11 symbol detection (optional) ------------------------------
YOLO_ENABLE_CUSTOM=false
YOLO_MODEL_PATH=models/yolov11/best.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
