# Engineering Drawing Analysis System - Environment Variables
# Copy this to .env and fill in your values

# Gemini API Key (required for VLM analysis)
GEMINI_API_KEY=""

# OCR Settings
OCR_USE_GPU=false
OCR_LANG=en

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# PDF rendering DPI (higher = better quality but slower)
PDF_RENDER_DPI=300

# YOLO Custom Model (optional, for future use)
YOLO_ENABLE_CUSTOM=false
# YOLO_MODEL_PATH=models/yolov11/best.pt
